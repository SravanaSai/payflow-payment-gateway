<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Intentionally NO parent here. If platform-bom inherited from the root POM,
      and the root imports this BOM, Maven detects a circular import cycle.
      This module stands alone as a version catalog.
    -->
    <groupId>com.payflow</groupId>
    <artifactId>platform-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>PayFlow Platform BOM</name>
    <description>Central dependency version catalog for all PayFlow modules</description>

    <properties>
        <!-- ADR-0001: Boot 4.0.x pairs with Spring Cloud 2025.1.x (Oakwood) -->
        <spring-boot.version>4.0.7</spring-boot.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <flyway.version>11.8.2</flyway.version>
        <testcontainers.version>1.21.0</testcontainers.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <springdoc.version>2.8.6</springdoc.version>
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>
        <wiremock.version>3.13.1</wiremock.version>
    </properties>

    <!--
      BOM = Bill of Materials. This section pins VERSIONS only.
      Child modules declare dependencies without version numbers.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM — manages Spring, Jackson, JUnit, etc. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Oakwood — Gateway, OpenFeign, etc. (used from Phase 1+) -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal shared libraries -->
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>common-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>common-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
