# Copy to .env and adjust if ports clash with other local services.
# cp .env.example .env
#
# Note: if port 5432 is already taken (local Postgres), use POSTGRES_PORT=5433

COMPOSE_PROJECT_NAME=payflow

# PostgreSQL
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka — host clients use 9092; containers use kafka:29092 internally
KAFKA_HOST_PORT=9092

# Kafka UI — 8090 so 8080 stays free for the edge gateway
KAFKA_UI_PORT=8090

# Jaeger UI + OTLP
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Prometheus + Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# merchant-service — API key pepper (generate with: openssl rand -base64 32)
PAYFLOW_API_KEY_PEPPER=
